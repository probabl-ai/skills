---
import Button from '../Button.astro';
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';
import PixelGrid from '../PixelGrid.astro';

const scaleOptions = [
  {
    number: '01',
    icon: 'agent',
    title: 'Remote agent',
    body: 'Connect your agent to the LLM provider you already use.',
  },
  {
    number: '02',
    icon: 'compute',
    title: 'Remote compute',
    body: 'Scale experiments onto your infrastructure.',
  },
  {
    number: '03',
    icon: 'storage',
    title: 'Remote storage',
    body: 'Keep every experiment, so no result is lost.',
  },
  {
    number: '04',
    icon: 'interface',
    title: 'Skore UI',
    body: 'Investigate experiment findings without leaving Skore.',
  },
];

const pages = [scaleOptions.slice(0, 2), scaleOptions.slice(2)];
---
<section id="scale" aria-labelledby="skore-heading" class="relative isolate scroll-mt-6 bg-beige">
  <PixelGrid />
  <Container class="pt-0 pb-20 md:pb-28">
    <header class="text-center">
      <Eyebrow class="text-blue-light">Scale with Skore</Eyebrow>
      <h2 id="skore-heading" class="mx-auto mt-3.5 text-40">
        Start locally.<br />Scale when the work is ready.
      </h2>
    </header>
    <div class="reveal mt-12 overflow-hidden rounded-lg bg-blue p-7 text-white md:mt-16 md:p-12" data-scroll>
      <div class="grid items-center gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <h3 class="text-40 text-white">
            Your team needs velocity
          </h3>
          <p class="mt-6 text-17 text-white/75">
            In the enterprise, velocity matters. Our skills bring methodological backing and statistical thinking. Skore is the platform that scales the data science experiment: a <strong class="text-white">remote agent</strong> on your LLM provider, <strong class="text-white">remote compute</strong> on your infrastructure, <strong class="text-white">remote storage</strong> so no result is lost, and a <strong class="text-white">Skore UI</strong> where data scientists investigate the findings.
          </p>
          <Button
            href="https://www.probabl.ai/skore/"
            variant="inverted"
            class="mt-8"
            external
            target="_blank"
            rel="noopener"
          >
            Discover Skore
          </Button>
        </div>
        <div
          class="min-w-0 lg:col-span-5 lg:col-start-8 lg:max-w-sm lg:justify-self-end"
          data-skore-carousel
          role="region"
          aria-roledescription="carousel"
          aria-label="How Skore scales an experiment"
        >
          <div class="overflow-hidden">
            <ul data-track class="flex">
              {
                pages.map((page, index) => (
                  <li
                    id={`skore-slide-${index}`}
                    data-slide
                    class="grid min-w-0 shrink-0 basis-full grid-cols-2 gap-4"
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    inert={index !== 0}
                  >
                    {page.map((option) => (
                    <div class="flex min-h-56 min-w-0 flex-col rounded-sm bg-white/8 p-5">
                      <div class="flex items-center justify-between gap-3">
                        <svg class="size-6 shrink-0 text-blue-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          {option.icon === 'agent' && (
                            <>
                              <circle cx="6" cy="12" r="2.25" />
                              <circle cx="17" cy="7" r="2.25" />
                              <circle cx="17" cy="17" r="2.25" />
                              <path d="M8.1 11.1 14.8 8.1" />
                              <path d="M8.1 12.9 14.8 15.9" />
                            </>
                          )}
                          {option.icon === 'compute' && (
                            <>
                              <rect x="7" y="7" width="10" height="10" rx="1.5" />
                              <path d="M9.5 4.5V7" />
                              <path d="M12 4.5V7" />
                              <path d="M14.5 4.5V7" />
                              <path d="M9.5 17v2.5" />
                              <path d="M12 17v2.5" />
                              <path d="M14.5 17v2.5" />
                              <path d="M4.5 9.5H7" />
                              <path d="M4.5 12H7" />
                              <path d="M4.5 14.5H7" />
                              <path d="M17 9.5h2.5" />
                              <path d="M17 12h2.5" />
                              <path d="M17 14.5h2.5" />
                            </>
                          )}
                          {option.icon === 'storage' && (
                            <>
                              <ellipse cx="12" cy="6.5" rx="6.5" ry="2.5" />
                              <path d="M5.5 6.5v11c0 1.38 2.91 2.5 6.5 2.5s6.5-1.12 6.5-2.5v-11" />
                              <path d="M5.5 12c0 1.38 2.91 2.5 6.5 2.5s6.5-1.12 6.5-2.5" />
                            </>
                          )}
                          {option.icon === 'interface' && (
                            <>
                              <rect x="3.5" y="4" width="17" height="16" rx="1.5" />
                              <path d="M3.5 8h17" />
                              <path d="M8 16.25 11.1 13l2.3 1.7L17.5 10" />
                            </>
                          )}
                        </svg>
                        <span class="font-mono text-11 text-blue-light">{option.number}</span>
                      </div>
                      <h3 class="mt-auto text-20 text-white">{option.title}</h3>
                      <p class="mt-3 text-13 text-white/65">{option.body}</p>
                    </div>
                    ))}
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="mt-4 flex gap-2">
            {
              pages.map((page, index) => (
                <button
                  type="button"
                  data-tab
                  class="relative h-6 w-8"
                  aria-label={page.map((option) => option.title).join(' and ')}
                  aria-controls={`skore-slide-${index}`}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 overflow-hidden rounded-full bg-white/20">
                    <span data-fill class="absolute inset-0 origin-left bg-blue-light"></span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  [data-track] {
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-fill] {
    transform: scaleX(0);
  }

  [aria-current='true'] [data-fill] {
    transform: scaleX(1);
  }

  [data-playing] [aria-current='true'] [data-fill] {
    animation: skore-carousel-progress 5s linear forwards;
  }

  [data-skore-carousel]:hover [data-fill],
  [data-skore-carousel]:focus-within [data-fill] {
    animation-play-state: paused;
  }

  @keyframes skore-carousel-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-track] {
      transition: none;
    }

    [data-playing] [aria-current='true'] [data-fill] {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  const carousel = document.querySelector('[data-skore-carousel]');
  if (carousel instanceof HTMLElement) {
    const track = carousel.querySelector('[data-track]');
    const slides = [...carousel.querySelectorAll('[data-slide]')];
    const tabs = [...carousel.querySelectorAll('[data-tab]')];
    const motionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let inView = false;

    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      if (track instanceof HTMLElement) {
        track.style.transform = `translate3d(${-index * 100}%, 0, 0)`;
      }
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.toggleAttribute('inert', !active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      tabs.forEach((tab, tabIndex) => {
        if (tabIndex === index) tab.setAttribute('aria-current', 'true');
        else tab.removeAttribute('aria-current');
      });
    };

    const setPlaying = (playing: boolean) => {
      carousel.toggleAttribute('data-playing', playing && motionOk && inView && !document.hidden);
    };

    tabs.forEach((tab, tabIndex) => {
      tab.addEventListener('click', () => show(tabIndex));
    });

    carousel.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;
      if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
      event.preventDefault();
      const next = event.key === 'ArrowRight' ? index + 1 : index - 1;
      show(next);
      if (tabs[index] instanceof HTMLElement) tabs[index].focus();
    });

    carousel.addEventListener('animationend', (event) => {
      if (!(event.target instanceof Element) || !event.target.hasAttribute('data-fill')) return;
      show(index + 1);
    });

    if (motionOk) {
      const observer = new IntersectionObserver(([entry]) => {
        inView = entry?.isIntersecting ?? false;
        setPlaying(inView);
      }, { threshold: 0.6 });
      observer.observe(carousel);
      document.addEventListener('visibilitychange', () => setPlaying(!document.hidden));
    }
  }
</script>
