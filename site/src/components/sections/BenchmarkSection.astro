---
import Container from '../Container.astro';
import Eyebrow from '../Eyebrow.astro';

const datasets = [
  { id: 'renewables', label: 'Dataset 1', color: '#2C318F' },
  { id: 'DVF', label: 'Dataset 2', color: '#5C6AD6' },
  { id: 'DPE', label: 'Dataset 3', color: '#A9B0EA' },
  { id: 'SIRENE', label: 'Dataset 4', color: '#FF7900' },
  { id: 'accidents', label: 'Dataset 5', color: '#E3A36A' },
  { id: 'water', label: 'Dataset 6', color: '#B0B3BC' },
];

const colorOf = Object.fromEntries(datasets.map((dataset) => [dataset.id, dataset.color]));

const panels = [
  {
    title: 'Time to a working model',
    arms: [
      {
        label: 'Plain coding loop',
        n: '18',
        mean: 65.6,
        meanColor: '#8A8D98',
        points: [
          { m: 135, dataset: 'DVF', j: -0.7 },
          { m: 129, dataset: 'SIRENE', j: 0.5 },
          { m: 112, dataset: 'DPE', j: -0.1 },
          { m: 108, dataset: 'accidents', j: 1.0 },
          { m: 100, dataset: 'DVF', j: -0.5 },
          { m: 83, dataset: 'DPE', j: 0.1 },
          { m: 68, dataset: 'accidents', j: 0.7 },
          { m: 64, dataset: 'accidents', j: 1.1 },
          { m: 61, dataset: 'DPE', j: -0.3 },
          { m: 60, dataset: 'DVF', j: -0.9 },
          { m: 56, dataset: 'water', j: 1.3 },
          { m: 47, dataset: 'SIRENE', j: 0.4 },
          { m: 45, dataset: 'SIRENE', j: 0.1 },
          { m: 30, dataset: 'renewables', j: -0.4 },
          { m: 28, dataset: 'renewables', j: -1.0 },
          { m: 27, dataset: 'water', j: 0.8 },
          { m: 20, dataset: 'water', j: 1.2 },
          { m: 13, dataset: 'renewables', j: -1.2 },
        ],
      },
      {
        label: 'With the skills',
        n: '18',
        mean: 36.9,
        meanColor: '#2C318F',
        points: [
          { m: 78, dataset: 'water', j: 0.7 },
          { m: 76, dataset: 'SIRENE', j: -0.1 },
          { m: 62, dataset: 'SIRENE', j: -0.3 },
          { m: 61, dataset: 'water', j: 1.0 },
          { m: 52, dataset: 'DPE', j: -0.8 },
          { m: 50, dataset: 'SIRENE', j: -0.4 },
          { m: 49, dataset: 'water', j: 0.8 },
          { m: 46, dataset: 'renewables', j: -0.2 },
          { m: 42, dataset: 'DPE', j: 0.3 },
          { m: 39, dataset: 'DPE', j: -0.6 },
          { m: 33, dataset: 'accidents', j: 0.5 },
          { m: 24, dataset: 'DVF', j: -1.0 },
          { m: 21, dataset: 'DVF', j: -0.5 },
          { m: 18, dataset: 'DVF', j: -1.3 },
          { m: 18, dataset: 'accidents', j: 0.2 },
          { m: 17, dataset: 'DPE', j: -0.2 },
          { m: 10, dataset: 'accidents', j: 0.6 },
          { m: 8, dataset: 'renewables', j: -0.9 },
        ],
      },
    ],
  },
  {
    title: 'Time to a hand-written baseline',
    arms: [
      {
        label: 'Plain coding loop',
        n: '18',
        mean: 72.3,
        meanColor: '#8A8D98',
        points: [
          { m: 167, dataset: 'SIRENE', j: 0.3 },
          { m: 135, dataset: 'DVF', j: -0.8 },
          { m: 129, dataset: 'SIRENE', j: 0.2 },
          { m: 112, dataset: 'DPE', j: -0.3 },
          { m: 108, dataset: 'accidents', j: 0.8 },
          { m: 100, dataset: 'DVF', j: -0.6 },
          { m: 83, dataset: 'DPE', j: 0.2 },
          { m: 68, dataset: 'accidents', j: 0.9 },
          { m: 61, dataset: 'DPE', j: -0.4 },
          { m: 60, dataset: 'DVF', j: -1.0 },
          { m: 56, dataset: 'water', j: 1.1 },
          { m: 45, dataset: 'SIRENE', j: 0.0 },
          { m: 30, dataset: 'renewables', j: -0.5 },
          { m: 28, dataset: 'renewables', j: -1.1 },
          { m: 27, dataset: 'water', j: 0.7 },
          { m: 20, dataset: 'water', j: 1.2 },
          { m: 14, dataset: 'renewables', j: -0.7 },
          { m: 13, dataset: 'DVF', j: -1.4 },
        ],
      },
      {
        label: 'With the skills',
        n: '17',
        mean: 48.9,
        meanColor: '#2C318F',
        points: [
          { m: 176, dataset: 'SIRENE', j: 0.0 },
          { m: 130, dataset: 'SIRENE', j: 0.4 },
          { m: 62, dataset: 'SIRENE', j: 0.2 },
          { m: 61, dataset: 'water', j: 1.1 },
          { m: 56, dataset: 'renewables', j: -0.6 },
          { m: 41, dataset: 'DVF', j: -0.8 },
          { m: 38, dataset: 'DVF', j: -1.3 },
          { m: 38, dataset: 'DPE', j: -0.3 },
          { m: 33, dataset: 'accidents', j: 0.7 },
          { m: 24, dataset: 'DVF', j: -0.9 },
          { m: 21, dataset: 'renewables', j: -0.4 },
          { m: 18, dataset: 'accidents', j: 0.5 },
          { m: 17, dataset: 'DPE', j: -0.1 },
          { m: 15, dataset: 'DVF', j: -1.4 },
          { m: 10, dataset: 'accidents', j: 0.9 },
          { m: 9, dataset: 'renewables', j: -1.0 },
          { m: 8, dataset: 'water', j: 0.3 },
        ],
      },
    ],
  },
];

const facts = [
  {
    label: 'Mean rounds',
    value: '1.28',
    other: '1.67',
    body: 'Rounds to a working model, with the skills first.',
  },
  {
    label: 'Round timeouts',
    value: '6',
    other: '28',
    body: 'Rounds that hit the time limit, with the skills first.',
  },
  {
    label: 'Final quality',
    value: 'Level',
    other: '',
    body: '17 of 18 runs with the skills match a hand-written baseline, and 18 of 18 do without. The run that falls short is drinking-water.',
  },
];

const ticks = [0, 30, 60, 90, 120, 150, 180];
const rowCenter = 5;
const jitter = 1.15;
---
<section id="benchmark" aria-labelledby="benchmark-heading" class="scroll-mt-6 bg-beige">
  <Container class="py-20 md:py-28">
    <header class="text-center">
      <Eyebrow>Benchmark</Eyebrow>
      <h2 id="benchmark-heading" class="mx-auto mt-4 max-w-3xl text-56 text-balance">
        A working model, sooner.
      </h2>
      <p class="mx-auto mt-7 max-w-2xl text-17">
        Same model, same harness, same data. The skills change how long it takes to reach a working predictive model.
      </p>
    </header>

    <div class="reveal mt-12 overflow-hidden rounded-lg bg-white shadow-lg md:mt-16" data-scroll>
      <div class="flex items-start justify-between gap-4 border-b border-black/10 px-6 py-5">
        <div>
          <p class="font-mono text-11 uppercase">Time to a result</p>
          <p class="mt-1.5 text-13 text-black/60">
            DeepSeek V4 Flash in OpenCode. Six open-data tasks. One point is one run.
          </p>
        </div>
        <div class="group relative shrink-0">
          <button type="button" class="cursor-help text-black/50" aria-describedby="benchmark-note">
            <span class="sr-only">About these results</span>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v5" stroke-linecap="round" />
              <circle cx="12" cy="8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </button>
          <p id="benchmark-note" role="tooltip" class="invisible absolute top-full right-0 z-10 w-72 pt-2 group-focus-within:visible group-hover:visible">
            <span class="block rounded-md bg-blue px-3 py-2 text-left text-13 text-white shadow-lg">
              A working model is a valid result that beats a trivial baseline. The hand-written baseline is the stronger bar. One drinking-water run with the skills never reached it, so that row has 17 runs.
            </span>
          </p>
        </div>
      </div>
      <div class="p-6 md:px-10 md:py-8">
          <figure>
            <figcaption class="sr-only">
              Time to a working model averages 65.6 minutes with a plain coding loop and 36.9 minutes with the
              skills, across 18 runs each. Time to a result at least as good as a hand-written baseline averages
              72.3 minutes with a plain coding loop, across 18 runs, and 48.9 minutes with the skills, across 17
              runs. Points are colored Dataset 1 through Dataset 6.
            </figcaption>
            <div class="grid gap-4 lg:grid-cols-2 lg:gap-5" aria-hidden="true">
              {
                panels.map((panel) => (
                  <div class="rounded-lg bg-beige px-4 py-5 sm:px-5">
                    <p class="text-center font-sans text-15 font-medium">{panel.title}</p>
                    <div class="mt-4 space-y-3">
                      {
                        panel.arms.map((arm) => (
                          <div>
                            <div class="mb-1 flex items-baseline justify-between gap-3">
                              <p class="text-13 font-medium">{arm.label}</p>
                              <p class="font-mono text-11">
                                <span style={`color: ${arm.meanColor}`}>{arm.mean}</span>
                                <span class="text-black/45">{` min · n = ${arm.n}`}</span>
                              </p>
                            </div>
                            <svg viewBox="0 0 180 10" class="block w-full">
                              {
                                ticks.map((tick) => (
                                  <line
                                    x1={tick}
                                    x2={tick}
                                    y1="1.6"
                                    y2="8.6"
                                    stroke="#121212"
                                    stroke-opacity="0.08"
                                  />
                                ))
                              }
                              <line
                                x1={arm.mean}
                                x2={arm.mean}
                                y1="1.8"
                                y2="8.4"
                                stroke={arm.meanColor}
                                stroke-width="0.7"
                              />
                              {
                                arm.points.map((point) => (
                                  <circle
                                    cx={point.m}
                                    cy={rowCenter + point.j * jitter}
                                    r="1.65"
                                    fill={colorOf[point.dataset]}
                                  />
                                ))
                              }
                            </svg>
                          </div>
                        ))
                      }
                    </div>
                    <svg viewBox="0 0 180 4" class="mt-1 block w-full">
                      {
                        ticks.map((tick) => (
                          <text
                            x={tick}
                            y="3.1"
                            text-anchor={tick === 0 ? 'start' : tick === 180 ? 'end' : 'middle'}
                            fill="#121212"
                            fill-opacity="0.45"
                            font-size="3.2"
                            font-family="ui-monospace, monospace"
                          >
                            {tick}
                          </text>
                        ))
                      }
                    </svg>
                    <p class="mt-0.5 text-center font-mono text-11 text-black/45">minutes</p>
                  </div>
                ))
              }
            </div>
          </figure>
          <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2" aria-hidden="true">
            {
              datasets.map((dataset) => (
                <li class="flex items-center gap-1.5 font-mono text-11 text-black/70">
                  <span class="size-2.5 rounded-full" style={`background: ${dataset.color}`}></span>
                  {dataset.label}
                </li>
              ))
            }
          </ul>
        <ul class="mt-6 grid border-t border-black/10 sm:grid-cols-3 sm:divide-x sm:divide-black/10">
          {
            facts.map((fact) => (
              <li class="border-b border-black/10 py-4 last:border-b-0 sm:border-b-0 sm:px-6 sm:pt-5 sm:pb-0 sm:first:pl-0 sm:last:pr-0">
                <p class="font-mono text-11 uppercase">{fact.label}</p>
                <p class="mt-2 text-25">
                  {fact.value}
                  {fact.other && <span class="text-black/40"> / {fact.other}</span>}
                </p>
                <p class="mt-1.5 text-13 text-black/65">{fact.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</section>
