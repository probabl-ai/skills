---
interface Command {
  id: string;
  label: string;
  command: string;
}

interface Props {
  items: Command[];
  label: string;
  idPrefix: string;
}

const { items, label, idPrefix } = Astro.props;
---
<div data-install-tabs class="contents">
  <div class="flex items-center justify-between gap-3">
    <slot name="icon" />
    <div
      role="tablist"
      aria-label={label}
      class="inline-flex max-w-full min-w-0 overflow-x-auto rounded-sm border border-black/10 p-0.5"
    >
    {
      items.map((item, index) => (
        <button
          id={`${idPrefix}-tab-${item.id}`}
          type="button"
          role="tab"
          aria-controls={`${idPrefix}-panel-${item.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-installer-tab
          data-index={index}
          class="rounded-[3px] px-3 py-1.5 font-mono text-13 text-black/55 transition-colors hover:text-black aria-selected:bg-beige aria-selected:text-black"
        >
          {item.label}
        </button>
      ))
    }
    </div>
  </div>
  <slot />
  <div class="mt-auto pt-6 xl:mt-0 xl:self-end">
    {
      items.map((item) => (
        <div
          id={`${idPrefix}-panel-${item.id}`}
          role="tabpanel"
          aria-labelledby={`${idPrefix}-tab-${item.id}`}
          data-installer-panel
          class="install-panel overflow-x-auto rounded-sm bg-blue px-4 py-3.5 font-mono text-13 text-white"
        >
          <pre><span class="select-none text-orange">❯ </span><code>{item.command}</code></pre>
        </div>
      ))
    }
  </div>
</div>

<style>
  [data-install-tabs][data-enhanced] [data-installer-panel][hidden] {
    display: none;
  }

  [data-install-tabs]:not([data-enhanced]) .install-panel + .install-panel {
    margin-top: 0.75rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-install-tabs]').forEach((tabs) => {
    const buttons = Array.from(tabs.querySelectorAll<HTMLButtonElement>('[data-installer-tab]'));
    const panels = Array.from(tabs.querySelectorAll<HTMLElement>('[data-installer-panel]'));

    const activate = (index: number, focus = false) => {
      buttons.forEach((button, buttonIndex) => {
        const active = buttonIndex === index;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
        if (active && focus) button.focus();
      });
      panels.forEach((panel, panelIndex) => {
        panel.hidden = panelIndex !== index;
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => activate(index));
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();

        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % buttons.length;
        if (event.key === 'ArrowLeft') nextIndex = (index - 1 + buttons.length) % buttons.length;
        if (event.key === 'Home') nextIndex = 0;
        if (event.key === 'End') nextIndex = buttons.length - 1;
        activate(nextIndex, true);
      });
    });

    tabs.dataset.enhanced = '';
    activate(0);
  });
</script>
