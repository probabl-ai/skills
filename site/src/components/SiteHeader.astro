---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.svg';
import Button from './Button.astro';
import Container from './Container.astro';
---
<header class="bg-beige">
  <nav aria-label="Main">
    <Container class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6">
      <a href="https://www.probabl.ai/" class="shrink-0">
        <Image class="h-8 w-auto md:h-9" src={logo} alt="Probabl" loading="eager" />
      </a>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-x-7">
        <a href="#get-started" class="link-underline-hover text-15">Get started</a>
        <a href="#how-it-works" class="link-underline-hover text-15">How it works</a>
        <a href="#benchmark" class="link-underline-hover text-15">Benchmark</a>
        <Button href="https://www.probabl.ai/skore/" external target="_blank" rel="noopener">Skore</Button>
      </div>
    </Container>
  </nav>
</header>
