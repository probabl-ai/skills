---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import Eyebrow from '../components/Eyebrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BenchmarkSection from '../components/sections/BenchmarkSection.astro';
import CapabilityStories from '../components/sections/CapabilityStories.astro';
import GettingStarted from '../components/sections/GettingStarted.astro';
import SkoreCta from '../components/sections/SkoreCta.astro';
import VideoShowcase from '../components/sections/VideoShowcase.astro';
import Layout from '../layouts/Layout.astro';

const description =
  'Bring your agent and your model. Our skills and libraries organize, build, and evaluate the project, with the expertise from more than a decade of building scikit-learn.';
---
<Layout title="Data Science Skills by Probabl" description={description}>
  <SiteHeader />
  <main id="main">
    <section aria-labelledby="hero-heading" class="bg-beige">
      <Container class="pt-14 pb-16 text-center md:pt-20 md:pb-24">
        <div class="mx-auto max-w-4xl">
          <Eyebrow highlight size="12" class="hero-item">Data Science Skills by Probabl</Eyebrow>
          <h1 id="hero-heading" class="hero-item mx-auto mt-7 max-w-4xl -mb-[0.2em] pb-[0.2em] text-64 text-balance">
            Tell us your problem. Let's experiment together.
          </h1>
          <p class="hero-item mx-auto mt-7 max-w-2xl text-17">
            {description}
          </p>
          <div class="hero-item mt-8.5 flex flex-wrap items-center justify-center gap-3">
            <Button href="#get-started">Get started</Button>
            <Button href="https://www.probabl.ai/contact/" variant="outline" external target="_blank" rel="noopener">
              Book a demo
            </Button>
          </div>
        </div>
      </Container>
    </section>
    <VideoShowcase />
    <GettingStarted />
    <CapabilityStories />
    <BenchmarkSection />
    <SkoreCta />
  </main>
  <SiteFooter />
</Layout>

<style is:global>
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(0.95);
      filter: blur(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-item {
      animation: hero-in 0.5s ease-out backwards;
      animation-delay: calc(var(--hero-index, 0) * 150ms);
    }
    .hero-item:nth-child(2) { --hero-index: 1; }
    .hero-item:nth-child(3) { --hero-index: 2; }
    .hero-item:nth-child(4) { --hero-index: 3; }
  }
</style>
