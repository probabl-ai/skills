{
  "forks": [
    {
      "id": "decline-workspace",
      "after": "setup-open",
      "say": "Do not select the workspace layout. Select the Python environment, the editable install, and Git.",
      "expect": {
        "files": [
          "DATA.md",
          "data/raw/housing.csv"
        ],
        "absent": [
          "src",
          "journal",
          "experiments",
          ".git"
        ]
      }
    },
    {
      "id": "decline-git",
      "after": "setup-open",
      "say": "Do not select Git. Select the Python environment, the workspace layout, and the editable install.",
      "expect": {
        "files": [
          "DATA.md",
          "data/raw/housing.csv",
          ".skore"
        ],
        "absent": [
          "src",
          "journal",
          "experiments",
          ".git"
        ],
        "contains": {
          ".skore": [
            "\"git\": \"declined\""
          ]
        }
      }
    },
    {
      "id": "you-pick-name",
      "after": "setup-managed",
      "say": "You pick the import name.",
      "expect": {
        "files": [
          "DATA.md",
          "data/raw/housing.csv",
          ".skore"
        ],
        "absent": [
          "src",
          "journal",
          "experiments",
          ".git"
        ],
        "contains": {
          ".skore": [
            "\"env_manager\": \"pixi\"",
            "\"managed\": true"
          ]
        }
      }
    },
    {
      "id": "skip-eda",
      "after": "setup-autocommit",
      "say": "Skip the data analysis.",
      "expect": {
        "files": [
          "journal/JOURNAL.md",
          "src/housing/pipeline.py",
          "data/raw/housing.csv"
        ],
        "absent": [
          "journal/01_*.md",
          "experiments/*.py",
          "data_analysis/data_analysis.md"
        ],
        "contains": {
          "journal/JOURNAL.md": [
            "| Status | skipped"
          ]
        }
      }
    },
    {
      "id": "lock-same-turn",
      "after": "frame-open",
      "say": "Prediction goal: point_predictions. Deployment: iid. Horizon: n/a. Gap: n/a. Generalize to: n/a. Known at predict: n/a. Time role: n/a. Metric role: point_error. Metric: RMSE. Baseline: dummy. Baseline note: mean house value. Folds: 2. Lock these decisions.",
      "expect": {
        "files": [
          "journal/JOURNAL.md",
          "journal/01_*.md",
          "src/housing/pipeline.py"
        ],
        "absent": [
          "experiments/*.py"
        ],
        "contains": {
          "journal/JOURNAL.md": [
            "| Status | locked |",
            "| Prediction goal | point_predictions |",
            "| Deployment | iid |",
            "| Baseline | dummy |",
            "| Folds | 2 |"
          ]
        },
        "contains_any": {
          "journal/01_*.md": [
            "**State:** planned"
          ]
        }
      }
    },
    {
      "id": "discuss-baseline",
      "after": "frame-fill",
      "say": "Discuss the next step.",
      "expect": {
        "files": [
          "journal/JOURNAL.md",
          "journal/01_*.md",
          "src/housing/pipeline.py"
        ],
        "absent": [
          "experiments/*.py"
        ],
        "contains": {
          "journal/JOURNAL.md": [
            "| Status | locked |"
          ]
        },
        "contains_any": {
          "journal/01_*.md": [
            "**State:** planned"
          ]
        }
      }
    },
    {
      "id": "stop-design",
      "after": "frame-fill",
      "say": "Stop.",
      "expect": {
        "files": [
          "journal/01_*.md",
          "journal/JOURNAL.md"
        ],
        "absent": [
          "experiments/*.py",
          "tests/smoke/test_01_*.py"
        ],
        "contains_any": {
          "journal/01_*.md": [
            "**State:** planned"
          ]
        }
      }
    },
    {
      "id": "modify-design",
      "after": "frame-fill",
      "say": "Modify the method, then ask me again.",
      "expect": {
        "files": [
          "journal/01_*.md"
        ],
        "absent": [
          "experiments/*.py",
          "tests/smoke/test_01_*.py"
        ],
        "contains_any": {
          "journal/01_*.md": [
            "**State:** planned"
          ]
        }
      }
    },
    {
      "id": "stop-after-smoke",
      "after": "baseline-approve",
      "say": "Stop.",
      "expect": {
        "files": [
          "experiments/01_*.py",
          "tests/smoke/test_01_*.py",
          "journal/01_*.md"
        ],
        "absent": [
          "scratch/results/01_*/report.html",
          "journal/ideas/*.md"
        ]
      }
    },
    {
      "id": "discard-ideas",
      "after": "baseline-close-audit",
      "say": "Discard every open idea.",
      "expect": {
        "files": [
          "journal/ideas/*.md",
          "journal/JOURNAL.md",
          "scratch/results/01_*/report.html"
        ],
        "absent": [
          "journal/02_*.md",
          "experiments/02_*.py"
        ],
        "contains_any": {
          "journal/ideas/*.md": [
            "Triage: discarded"
          ]
        }
      }
    },
    {
      "id": "discuss-iterate",
      "after": "backlog-promote",
      "say": "Discuss what to try instead.",
      "expect": {
        "files": [
          "journal/JOURNAL.md",
          "journal/ideas/*.md",
          "journal/01_*.md"
        ],
        "absent": [
          "journal/02_*.md",
          "experiments/02_*.py"
        ],
        "contains": {
          "journal/JOURNAL.md": [
            "| B1 |"
          ]
        }
      }
    }
  ]
}
